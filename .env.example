# Backend Settings
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Database
# Local development default: SQLite
DATABASE_URL=sqlite:///./image_quality.db
# Docker Compose default: PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@db:5432/image_quality_db

# Model and Storage
MODEL_DIR=../ml/models
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
